// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  admin_id      Int      @id @default(autoincrement())
  name          String   @db.VarChar(100)
  email         String   @unique @db.VarChar(150)
  password_hash String     @db.VarChar(255)
  role          String     @default("placement_officer") @db.VarChar(50)
  drives        Drive[]
  audit_logs    AuditLog[]

  @@map("admin")
}

model Student {
  student_id    Int            @id @default(autoincrement())
  name          String         @db.VarChar(100)
  email         String         @unique @db.VarChar(150)
  password_hash String         @db.VarChar(255)
  branch        String         @db.VarChar(50)
  batch_year    Int
  cgpa          Decimal        @db.Decimal(4, 2)
  backlogs      Int            @default(0)
  resume_url    String?        @db.VarChar(255)
  phone         String?        @db.VarChar(15)
  applications  Application[]
  offers        Offer[]
  notifications Notification[]

  @@map("student")
}

model Company {
  company_id       Int     @id @default(autoincrement())
  name             String  @db.VarChar(150)
  password_hash    String? @db.VarChar(255)
  sector           String? @db.VarChar(100)
  hr_contact_email String? @db.VarChar(150)
  description      String? @db.Text
  drives           Drive[]

  @@map("company")
}

model Drive {
  drive_id            Int           @id @default(autoincrement())
  company_id          Int
  role_offered        String        @db.VarChar(150)
  ctc_offered         Decimal?      @db.Decimal(10, 2)
  drive_date          DateTime      @db.Date
  min_cgpa            Decimal       @db.Decimal(4, 2)
  max_backlogs        Int           @default(0)
  eligible_branches   String        @db.VarChar(255)
  status              String        @default("Open") @db.VarChar(30)
  created_by_admin_id Int?
  company             Company       @relation(fields: [company_id], references: [company_id], onDelete: Restrict)
  admin               Admin?        @relation(fields: [created_by_admin_id], references: [admin_id])
  applications        Application[]
  rounds              DriveRound[]

  @@index([company_id], name: "idx_drive_company")
  @@map("drive")
}

model DriveRound {
  round_id       Int           @id @default(autoincrement())
  drive_id       Int
  round_number   Int
  round_name     String        @db.VarChar(100)
  scheduled_date DateTime?     @db.Date
  drive          Drive         @relation(fields: [drive_id], references: [drive_id], onDelete: Cascade)
  results        RoundResult[]

  @@unique([drive_id, round_number])
  @@map("drive_round")
}

model Application {
  application_id Int           @id @default(autoincrement())
  student_id     Int
  drive_id       Int
  applied_date   DateTime      @default(now()) @db.Date
  current_status String        @default("Applied") @db.VarChar(30)
  student        Student       @relation(fields: [student_id], references: [student_id], onDelete: Cascade)
  drive          Drive         @relation(fields: [drive_id], references: [drive_id], onDelete: Restrict)
  results        RoundResult[]
  offer          Offer?

  @@unique([student_id, drive_id])
  @@index([student_id], name: "idx_application_student")
  @@index([drive_id], name: "idx_application_drive")
  @@map("application")
}

model RoundResult {
  result_id      Int        @id @default(autoincrement())
  application_id Int
  round_id       Int
  result         String     @default("Pending") @db.VarChar(20)
  remarks        String?    @db.Text
  evaluated_date DateTime?  @db.Date
  application    Application @relation(fields: [application_id], references: [application_id], onDelete: Cascade)
  round          DriveRound  @relation(fields: [round_id], references: [round_id], onDelete: Cascade)

  @@unique([application_id, round_id])
  @@index([application_id], name: "idx_roundresult_application")
  @@map("round_result")
}

model Offer {
  offer_id       Int         @id @default(autoincrement())
  application_id Int         @unique
  student_id     Int
  final_ctc      Decimal?    @db.Decimal(10, 2)
  offer_status   String      @default("Pending") @db.VarChar(30)
  offer_date     DateTime    @default(now()) @db.Date
  application    Application @relation(fields: [application_id], references: [application_id], onDelete: Cascade)
  student        Student     @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@map("offer")
}

model Notification {
  notification_id Int      @id @default(autoincrement())
  student_id      Int
  message         String   @db.Text
  is_read         Boolean  @default(false)
  created_at      DateTime @default(now())
  student         Student  @relation(fields: [student_id], references: [student_id], onDelete: Cascade)

  @@map("notification")
}

model AuditLog {
  log_id     Int      @id @default(autoincrement())
  admin_id   Int?
  action     String   @db.VarChar(150)
  target     String?  @db.VarChar(150)
  details    String?  @db.Text
  timestamp  DateTime @default(now())
  admin      Admin?   @relation(fields: [admin_id], references: [admin_id], onDelete: SetNull)

  @@map("audit_log")
}
